{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noUnusedLocals": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "paths": {
      "/*": ["./*"]
    }
  },
  "include": ["static/js/**/*.js", "static/js/**/*.d.ts"],
  "exclude": ["static/js/**/*.test.js"]
}
